{
  "name": "defftra-router",
  "version": "0.1.0",
  "description": "A lightweight, UI-driven local HTTP reverse proxy.",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "bin": {
    "defftra-router": "dist/defftra-router.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "tsx src/cli/dev.ts",
    "clean": "node scripts/clean-dist.ts",
    "build": "pnpm clean && tsc -p tsconfig.json --noEmit && vite build --config vite.server.config.ts && vite build && node scripts/prepare-dist.ts",
    "start": "node dist/defftra-router.mjs",
    "test": "vitest run --config vitest.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@eslint/js": "10.0.1",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
